{
  "properties": [
    {
      "name": "jwt.secret",
      "type": "java.lang.String",
      "description": "HMAC secret for signing JWT tokens (HS256)."
    },
    {
      "name": "jwt.expiration-ms",
      "type": "java.lang.Long",
      "description": "JWT expiration time in milliseconds."
    },
    {
      "name": "azure.openai.key",
      "type": "java.lang.String",
      "description": "Azure OpenAI API key."
    },
    {
      "name": "azure.openai.endpoint",
      "type": "java.lang.String",
      "description": "Azure OpenAI endpoint, e.g., https://<resource>.openai.azure.com"
    },
    {
      "name": "azure.openai.deployment",
      "type": "java.lang.String",
      "description": "Azure OpenAI deployment name, e.g., gpt-4o"
    },
    {
      "name": "azure.openai.api-version",
      "type": "java.lang.String",
      "description": "Azure OpenAI API version, e.g., 2025-01-01-preview"
    }
  ]
}